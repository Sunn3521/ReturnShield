# ReturnShield AI provider configuration
# Select one provider in the AI Settings panel or set it here.
# Supported providers:
# OpenRouter (Free), Groq (Free), Google Gemini, Hugging Face, Ollama (Local), OpenAI

AI_PROVIDER=OpenRouter (Free)
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=60

# Cloud-provider keys. Set only the key for the provider you use.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=

# Ollama uses local inference and does not require an API key.
# Example:
# AI_PROVIDER=Ollama (Local)
# AI_MODEL=gemma3
# AI_BASE_URL=http://localhost:11434/v1

# The ReturnShield Agent API remains the application/tool layer.
# The selected LLM provider is the natural-language reasoning layer.
